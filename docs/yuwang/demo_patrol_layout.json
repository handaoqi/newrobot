    "second": {
      "first": "Plot!democmd",
      "second": {
        "first": "RawMessages!demostatus",
        "second": "DiagnosticSummary!demodiag",
        "direction": "column",
        "splitPercentage": 60
      },
      "direction": "column",
      "splitPercentage": 50
