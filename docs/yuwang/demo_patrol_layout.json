        "/patrol/trajectory": {
          "visible": true,
          "lineWidth": 0.06,
          "gradient": [
            "#e5484dff",
            "#e5484dff"
          ]
        },
        "/plan": {
          "visible": true,
          "lineWidth": 0.08,
          "gradient": [
            "#b0b0b0ff",
            "#b0b0b0ff"
          ]
        },
        "/goal_pose": {
          "visible": true,
          "type": "arrow",
          "color": "#22c55eff"
        }
      },
      "layers": {},
      "publish": {
        "type": "point"
      }
    },
    "Image!democam": {
      "imageMode": {
        "imageTopic": "/camera/front/image/compressed",
        "synchronize": false
      }
    },
    "Plot!democmd": {
      "paths": [
        {
          "value": "/cmd_vel.linear.x",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "linear.x",
          "color": "#3b82f6"
        },
        {
          "value": "/cmd_vel.angular.z",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "angular.z",
          "color": "#e5484d"
        },
        {
          "value": "/odom.pose.pose.position.x",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "odom x",
          "color": "#f5a524"
        },
        {
          "value": "/odom.pose.pose.position.y",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "odom y",
          "color": "#22c55e"
        },
        {
          "value": "/battery_state.percentage",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "battery",
          "color": "#a855f7"
        }
      ],
      "showLegend": true,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "legendDisplay": "floating",
      "sidebarDimension": 240
