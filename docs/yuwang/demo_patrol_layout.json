  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": {
    "speed": 1
  },
  "layout": {
    "first": {
      "first": "3D!demoscene",
      "second": "Image!democam",
      "direction": "column",
      "splitPercentage": 68
