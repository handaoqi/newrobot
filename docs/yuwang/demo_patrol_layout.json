        "/scan": {
          "visible": true,
          "pointSize": 3,
          "colorMode": "flat",
          "flatColor": "#f0f0f0ff"
        },
        "/odom": {
          "visible": true,
          "type": "arrow",
          "color": "#e5484dff",
          "historySize": 1
