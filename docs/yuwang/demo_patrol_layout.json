{
  "configById": {
    "3D!demoscene": {
      "cameraState": {
        "perspective": true,
        "distance": 18,
        "phi": 50,
        "thetaOffset": 0,
        "targetOffset": [
          5,
          4,
          0
        ],
        "target": [
          0,
          0,
          0
        ],
        "targetOrientation": [
          0,
          0,
          0,
          1
        ],
        "fovy": 45,
        "near": 0.5,
        "far": 5000
