            "visible": true
          }
        },
        "synchronize": false
      }
    },
    "Plot!nuspose": {
      "paths": [
        {
          "value": "/pose.pose.position.x",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "pose x",
          "color": "#3b82f6"
        },
        {
          "value": "/pose.pose.position.y",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "pose y",
          "color": "#22c55e"
        },
        {
          "value": "/gps.altitude",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "gps alt",
          "color": "#f5a524"
        }
      ],
      "showLegend": true,
      "isSynced": true,
      "legendDisplay": "floating",
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "sidebarDimension": 240,
      "xAxisVal": "timestamp"
    },
    "RawMessages!nusgps": {
      "topicPath": "/gps",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false,
      "expansion": "all"
    },
    "DiagnosticSummary!nusdiag": {
      "minLevel": 0,
      "pinnedIds": [],
      "hardwareIdFilter": "",
      "topicToRender": "/diagnostics",
      "sortByLevel": true
