        "perspective": true,
        "distance": 45,
        "phi": 55,
        "thetaOffset": 45,
        "targetOffset": [
          0,
          0,
          0
        ],
        "target": [
          0,
          0,
          0
        ],
        "targetOrientation": [
          0,
