**/__pycache__/
**/.pytest_cache/
**/node_modules/
**/dist/
**/build/
**/install/
!runtime/
!runtime/*/
!runtime/*/install/
!runtime/*/install/**
# The negations above force-track everything under runtime/*/install, which is
# right for small vendor archives and manifests but wrong for the 40 MB
# Lichtblick tarball and its ~150 MB unpacked tree. Only the lock file and README
# are committed; fetch_lichtblick_web.sh reproduces the rest from the pinned URL.
runtime/*/install/lichtblick-web/dist/
runtime/*/install/lichtblick-web/*.tar.gz*
**/log/
*.py[cod]
*.secret.yaml
*.secret.yml
*.env
.env.*
!.env.example
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
known_hosts*

# Repository root is also the development user's home directory. Keep local
# shell, editor, agent and package-manager state out of project commits.
/.Xauthority
/.bash_history
/.viminfo
/.claude/
/.claude.json
/.codex/
/.codex-dev-agent/
/.npm/
/.dbus/
/.dotnet/
/.cache/
/.config/
/.local/
/.ros/
/.ssh/
/.vscode-server/
/.copilot/
/.cursor/
/.cursor-server/
/.wget-hsts
/.codex-robot-write-test
/.bashrc.before-*
/.profile.before-*

# Local permission probes and generated symlink inventories.
**/*.write_test
**/_wtest
/symlink_install_manifest.txt
/robot/symlink_install_manifest.txt
*.bag
*.db3
*.mcap
*.log
*.pid

# One-off browser probes and quarantined ROS build trees are local diagnostics,
# not reproducible project sources.
/platform/frontend/*.tmp.mjs
/runtime/roamerx-build-quarantine-*/
# Temporary Livox SDK source/build workspace. The reproducible source patch is
# tracked under robot/patches instead.
/runtime/livox-sdk2-system-spdlog/
# Temporary PTv3 source/build workspace.  Runtime accepts only deployed models
# and binaries under install/; reproducible source must live in a top-level
# source component.
/runtime/nx-edge/src/
/vscode:/
/vscode-remote:/
/roamerx-platform-docker-validation-*.tar.gz
/roamerx-platform-docker-validation-*.sha256
