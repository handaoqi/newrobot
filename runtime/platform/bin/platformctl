#!/usr/bin/env bash
set -euo pipefail

RUNTIME_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE_FILE="$RUNTIME_ROOT/compose.yaml"
ENV_FILE="$RUNTIME_ROOT/conf/platform.env"

require_docker() {
  command -v docker >/dev/null || {
    echo "Docker is missing. Run $RUNTIME_ROOT/scripts/install-docker.sh" >&2
    exit 1
  }
  docker compose version >/dev/null
}

init_runtime() {
  install -d "$RUNTIME_ROOT"/data/{backend/db,backend/media,backend/logs,mqtt,zlmediakit}
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$RUNTIME_ROOT/conf/platform.env.example" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
  fi
  if [[ ! -f "$RUNTIME_ROOT/conf/mosquitto.conf" ]]; then
    cp "$RUNTIME_ROOT/conf/mosquitto.conf.example" "$RUNTIME_ROOT/conf/mosquitto.conf"
  fi
  echo "Initialized $RUNTIME_ROOT. Edit $ENV_FILE before starting."
}

compose() {
  require_docker
  [[ -f "$ENV_FILE" ]] || init_runtime
  docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

preflight() {
  require_docker
  [[ -f "$ENV_FILE" ]] || { echo "Missing $ENV_FILE; run init first." >&2; exit 1; }
  [[ -s "$RUNTIME_ROOT/conf/mosquitto.passwd" ]] || {
    echo "Missing conf/mosquitto.passwd; run scripts/prepare-mqtt-password.sh" >&2
    exit 1
  }
  for key in DJANGO_SECRET_KEY DJANGO_ALLOWED_HOSTS DJANGO_CSRF_TRUSTED_ORIGINS PUBLIC_BASE_URL MQTT_PASSWORD; do
    value="$(grep -E "^${key}=" "$ENV_FILE" | tail -1 | cut -d= -f2- || true)"
    if [[ -z "$value" || "$value" =~ (change|example|replace|your_) ]]; then
      echo "Invalid production value: $key" >&2
      exit 1
    fi
  done
  source_root="$(grep -E '^ROAMERX_SOURCE_ROOT=' "$ENV_FILE" | cut -d= -f2- || true)"
  [[ -f "$source_root/platform/backend/Dockerfile" && -f "$source_root/platform/frontend/Dockerfile" ]] || {
    echo "Missing platform source under $source_root" >&2
    exit 1
  }
  free_kb="$(df -Pk "$RUNTIME_ROOT" | awk 'NR==2 {print $4}')"
  min_free_gb="${ROAMERX_MIN_FREE_GB:-10}"
  (( free_kb >= min_free_gb * 1024 * 1024 )) || {
    echo "Insufficient disk space: need at least ${min_free_gb} GiB free." >&2
    exit 1
  }
  if command -v systemctl >/dev/null; then
    for legacy_unit in roamerx-center-api.service roamerx-device-worker.service roamerx-patrol-scheduler.service; do
      if systemctl is-active --quiet "$legacy_unit" 2>/dev/null; then
        echo "Legacy platform service is active: $legacy_unit; stop it before Docker cutover." >&2
        exit 1
      fi
    done
  fi
  compose config --quiet
  echo "Platform preflight passed."
}

case "${1:-help}" in
  init) init_runtime ;;
  preflight) preflight ;;
  build) compose build --pull ;;
  up)
    preflight
    compose up -d --build
    ;;
  down) compose down ;;
  restart) compose restart ;;
  status) compose ps ;;
  logs) shift; compose logs -f --tail=200 "$@" ;;
  backup) "$RUNTIME_ROOT/scripts/backup.sh" ;;
  verify) "$RUNTIME_ROOT/scripts/verify.sh" ;;
  *) echo "Usage: $0 {init|preflight|build|up|down|restart|status|logs|backup|verify}" >&2; exit 2 ;;
esac
