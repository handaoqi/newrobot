COMPOSE_PROJECT_NAME=roamerx-platform
ROAMERX_SOURCE_ROOT=../..
PLATFORM_HTTP_PORT=8088
MQTT_EXTERNAL_PORT=1884
RTMP_EXTERNAL_PORT=1935
ZLM_HTTP_EXTERNAL_PORT=8080
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,platform.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://platform.example.com
PUBLIC_BASE_URL=https://platform.example.com
MQTT_USERNAME=roamerx
MQTT_PASSWORD=replace-with-a-strong-password
DEVICE_OFFLINE_TIMEOUT_SECONDS=30
COMMAND_ACK_TIMEOUT_SECONDS=5
COMMAND_RESULT_TIMEOUT_SECONDS=1800
ASR_ENABLED=false
ENABLE_DEMO_SEED=false
PLATFORM_OPERATOR_USERNAME=operator
PLATFORM_OPERATOR_PASSWORD=replace-with-a-strong-operator-password
PLATFORM_OPERATOR_EMAIL=
PLATFORM_ROBOT_CODE=ZSL-1A-07
PLATFORM_ROBOT_NAME=RoamerX ZSL-1A-07
PLATFORM_ROBOT_LOCATION=unassigned
PLATFORM_ROBOT_AREA=unassigned
