COMPOSE_PROJECT_NAME=roamerx-platform
ROAMERX_SOURCE_ROOT=../..
PLATFORM_HTTP_PORT=8088
MQTT_EXTERNAL_PORT=1884
RTMP_EXTERNAL_PORT=1935
ZLM_HTTP_EXTERNAL_PORT=8080
VALIDATION_OBJECT_STORE_PORT=9002
VALIDATION_OBJECT_STORE_CONSOLE_PORT=9003
VALIDATION_OBJECT_STORE_PUBLIC_ENDPOINT=https://objects.example.com
VALIDATION_OBJECT_STORE_BUCKET=roamerx-validation
VALIDATION_OBJECT_STORE_ACCESS_KEY=roamerx-validation
VALIDATION_OBJECT_STORE_SECRET_KEY=replace-with-a-strong-object-storage-password
VALIDATION_RUNNER_TOKEN=replace-with-a-separate-strong-runner-token
VALIDATION_GATEWAY_TOKEN=replace-with-a-separate-strong-gateway-token
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,platform.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://platform.example.com
PUBLIC_BASE_URL=https://platform.example.com
MQTT_USERNAME=roamerx
MQTT_PASSWORD=replace-with-a-strong-password
DEVICE_OFFLINE_TIMEOUT_SECONDS=30
COMMAND_ACK_TIMEOUT_SECONDS=5
COMMAND_RESULT_TIMEOUT_SECONDS=1800
INBOUND_MESSAGE_RETENTION_DAYS=30
INBOUND_MESSAGE_FAILED_RETENTION_DAYS=180
SYSTEM_LOG_DEBUG_RETENTION_DAYS=7
SYSTEM_LOG_INFO_RETENTION_DAYS=30
SYSTEM_LOG_WARNING_ERROR_RETENTION_DAYS=180
SYSTEM_LOG_CLEANUP_BATCH_SIZE=2000
INBOUND_MESSAGE_CLEANUP_BATCH_SIZE=2000
INBOUND_MESSAGE_CLEANUP_INTERVAL_SECONDS=3600
INBOUND_MESSAGE_STALE_PENDING_DAYS=7
INBOUND_MESSAGE_WEEKLY_CLEANUP_ENABLED=true
INBOUND_MESSAGE_WEEKLY_CLEANUP_WEEKDAY=0
INBOUND_MESSAGE_WEEKLY_CLEANUP_HOUR=3
INBOUND_MESSAGE_WEEKLY_CLEANUP_GRACE_HOURS=24
INBOUND_MESSAGE_WEEKLY_CLEANUP_MAX_BATCHES=10000
INBOUND_MESSAGE_WEEKLY_CLEANUP_TIME_BUDGET_SECONDS=600
ASR_ENABLED=false
ENABLE_DEMO_SEED=false
PLATFORM_OPERATOR_USERNAME=operator
PLATFORM_OPERATOR_PASSWORD=replace-with-a-strong-operator-password
PLATFORM_OPERATOR_EMAIL=
PLATFORM_ROBOT_CODE=ZSL-1A-07
PLATFORM_ROBOT_NAME=RoamerX ZSL-1A-07
PLATFORM_ROBOT_LOCATION=unassigned
PLATFORM_ROBOT_AREA=unassigned
