VITE_API_BASE=/api
VITE_DEVICE_AUDIO_BASE=http://192.168.234.16:5173
# Foxglove WebSocket endpoint for the replay console. Prefer a same-origin
# reverse proxy in production, for example wss://platform.example.com/foxglove/ws.
VITE_REPLAY_LIVE_WS=
# Maximum time spent probing a live stream before showing the no-signal state.
VITE_VIDEO_STREAM_CONNECT_TIMEOUT_MS=1800
# Maximum time allowed for demuxing and decoding the first live video frame.
VITE_VIDEO_STREAM_STARTUP_TIMEOUT_MS=10000
