DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=platform.example.com
POSTGRES_DB=roamerx
POSTGRES_USER=roamerx
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
MQTT_HOST=mqtt.example.com
