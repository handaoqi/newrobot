[Unit]
Description=RoamerX Durable Patrol Loop Supervisor
After=network.target roamerx-center-api.service roamerx-device-worker.service

[Service]
Type=simple
WorkingDirectory=/opt/roamerx/current
EnvironmentFile=/opt/roamerx/shared/center.env
ExecStart=/root/miniconda/envs/py310/bin/python backend/manage.py run_patrol_loop_supervisor --interval 1
Restart=always
RestartSec=3
StandardOutput=append:/opt/roamerx/shared/logs/patrol-loop-supervisor.log
StandardError=append:/opt/roamerx/shared/logs/patrol-loop-supervisor.err.log

[Install]
WantedBy=multi-user.target
