[Unit]
Description=RoamerX server-side scene build worker
After=network.target roamerx-center-api.service

[Service]
Type=simple
WorkingDirectory=/opt/roamerx/current
EnvironmentFile=/opt/roamerx/shared/center.env
ExecStart=/root/miniconda/envs/py310/bin/python backend/manage.py run_scene_build_worker
Restart=always
RestartSec=3
StandardOutput=append:/opt/roamerx/shared/logs/scene-build-worker.log
StandardError=append:/opt/roamerx/shared/logs/scene-build-worker.err.log

[Install]
WantedBy=multi-user.target
