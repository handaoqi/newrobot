#!/usr/bin/env bash
set -euo pipefail

LAN_IF="${ROAMERX_LAN_IF:-enP8p1s0}"
WAN_IF="${ROAMERX_WAN_IF:-enx020c29a39b6d}"
LAN_SUBNET="${ROAMERX_LAN_SUBNET:-192.168.234.0/24}"

sysctl -q -w net.ipv4.ip_forward=1

iptables -w 5 -t nat -C POSTROUTING -s "$LAN_SUBNET" -o "$WAN_IF" -j MASQUERADE 2>/dev/null \
  || iptables -w 5 -t nat -A POSTROUTING -s "$LAN_SUBNET" -o "$WAN_IF" -j MASQUERADE
iptables -w 5 -C FORWARD -i "$LAN_IF" -o "$WAN_IF" -s "$LAN_SUBNET" -j ACCEPT 2>/dev/null \
  || iptables -w 5 -A FORWARD -i "$LAN_IF" -o "$WAN_IF" -s "$LAN_SUBNET" -j ACCEPT
iptables -w 5 -C FORWARD -i "$WAN_IF" -o "$LAN_IF" -d "$LAN_SUBNET" \
  -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null \
  || iptables -w 5 -A FORWARD -i "$WAN_IF" -o "$LAN_IF" -d "$LAN_SUBNET" \
    -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
