[Unit]
Description=RoamerX Edge Agent
After=network-online.target chrony.service
Wants=network-online.target chrony.service

[Service]
Type=simple
User=robot
Group=robot
WorkingDirectory=/home/dogrobot/edge-agent
Environment=PYTHONUNBUFFERED=1
Environment=ROS_DOMAIN_ID=24
Environment=RMW_IMPLEMENTATION=rmw_zenoh_cpp
Environment=PROJECT_DIR=/home/dogrobot/robot
Environment=EDGE_SOURCE_DIR=/home/dogrobot/edge-agent
Environment=EDGE_RUNTIME_DIR=/home/robot/edge_agent
ExecStart=/home/dogrobot/edge-agent/start_edge.sh
Restart=always
RestartSec=5
# Sensors, localization and Nav2 are independently managed long-running
# processes. Restarting the MQTT Edge process must not terminate them.
KillMode=process
TimeoutStopSec=15
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
