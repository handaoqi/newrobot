[Unit]
Description=RoamerX SLAM mapping node
After=network-online.target roamerx-zenoh.service
Wants=network-online.target
# On-demand only. Edge Agent or start_mapping_real.sh starts this unit;
# do not enable it for boot.

[Service]
Type=simple
User=dogrobot
Group=robot
Environment=ROS_DOMAIN_ID=24
Environment=RMW_IMPLEMENTATION=rmw_zenoh_cpp
Environment=ROAMERX_MAPPING_TYPE=indoor
Environment=ROAMERX_AUTO_LOOP_OPTIMIZATION=false
Environment=ROAMERX_SLAM_PARAMS=/home/dogrobot/robot/install/robot_slam/share/robot_slam/config/config.yaml
Environment=ROAMERX_MAPPING_ORIGIN_PARAMS=/dev/null
EnvironmentFile=-/home/dogrobot/runtime/nx-edge/conf/mapping-session.env
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /home/dogrobot/robot/install/setup.bash && exec ros2 launch robot_slam unified_mapping.launch.py'
Restart=no
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
