[Unit]
Description=RoamerX SLAM mapping node
After=network-online.target roamerx-zenoh.service
Wants=network-online.target
# On-demand only. Edge Agent or start_mapping_real.sh starts this unit;
# do not enable it for boot.

[Service]
Type=simple
User=dogrobot
Group=robot
Environment=ROS_DOMAIN_ID=24
Environment=RMW_IMPLEMENTATION=rmw_zenoh_cpp
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /home/dogrobot/robot/install/setup.bash && exec /home/dogrobot/robot/install/robot_slam/lib/robot_slam/mapping --ros-args --params-file /home/dogrobot/robot/install/robot_slam/share/robot_slam/config/config.yaml'
Restart=no
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
