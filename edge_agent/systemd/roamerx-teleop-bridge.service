[Unit]
Description=RoamerX remote-control motion bridge
After=network-online.target roamerx-zenoh.service
Wants=network-online.target roamerx-zenoh.service

[Service]
Type=simple
User=robot
Group=robot
Environment=ROS_DOMAIN_ID=24
Environment=RMW_IMPLEMENTATION=rmw_zenoh_cpp
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && source /home/robot/genisom_roamerx_open/install/setup.bash && exec ros2 run robot_navigo vel_cmd_udp_pub --ros-args -p platform:=NX_XG3588 -p remote_control_only:=true'
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
