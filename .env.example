# Copy this file to .env or set these variables in your shell.
# Do not commit real passwords, keys, tokens, or public tunnel URLs.

# Web console
DOG_MVP_PORT=8765

# Local browser proxy with Basic Auth
DOG_WEB_TARGET=http://127.0.0.1:8765
DOG_WEB_USER=demo
DOG_WEB_PASSWORD=change-me
DOG_WEB_PROXY_PORT=8876

# Cloud jump server for remote development
DOG_REMOTE_SERVER_HOST=example.com
DOG_REMOTE_SERVER_PORT=22
DOG_REMOTE_SERVER_USER=mluser
DOG_REMOTE_SERVER_KEY=C:\Users\YOUR_USER\.ssh\dog_remote_mluser_ed25519
DOG_SSH_ASKPASS=

# Local forwarded ports used by start_dog_remote_control.cmd
DOG_REMOTE_LOCAL_RK_PORT=2201
DOG_REMOTE_LOCAL_ORIN_PORT=2202

# Robot-side addresses after the tunnel is available
DOG_JUMP_HOST=127.0.0.1
DOG_JUMP_PORT=2201
DOG_ORIN_HOST=127.0.0.1
DOG_ORIN_PORT=2202
