diff --git a/sdk_core/CMakeLists.txt b/sdk_core/CMakeLists.txt
index 15e960d..4128411 100644
--- a/sdk_core/CMakeLists.txt
+++ b/sdk_core/CMakeLists.txt
@@ -6,6 +6,13 @@ set(SDK_LIBRARY_SHARED livox_lidar_sdk_shared)
 add_library(${SDK_LIBRARY_STATIC} STATIC "")
 add_library(${SDK_LIBRARY_SHARED} SHARED "")

+# ROS 2 itself uses the distribution spdlog shared library.  Building the
+# Livox SDK against its vendored, header-only copy exports a second set of weak
+# spdlog symbols into the same process.  The dynamic linker may then construct
+# a logger with one ABI and destroy it with the other, which crashes during
+# LivoxLidarSdkUninit().  Use the same compiled spdlog implementation as ROS.
+find_package(spdlog REQUIRED)
+
 set(LIVOX_SDK_MAJOR_VERSION "0")
 set(LIVOX_SDK_MINOR_VERSION "0")
 set(LIVOX_SDK_PATCH_VERSION "2")
@@ -49,4 +56,6 @@ set(LIVOX_PUBLIC_INCLUDE_DIR
         ../include
         )

+list(REMOVE_ITEM LIVOX_PRIVATE_INCLUDE_DIR ../3rdparty/spdlog)
+
 target_include_directories(
@@ -136,6 +145,9 @@ target_sources(${SDK_LIBRARY_SHARED}
         ${LIVOX_SOURCES}
         )

+target_link_libraries(${SDK_LIBRARY_STATIC} PRIVATE spdlog::spdlog)
+target_link_libraries(${SDK_LIBRARY_SHARED} PRIVATE spdlog::spdlog)
+
 install(TARGETS ${SDK_LIBRARY_STATIC} ${SDK_LIBRARY_SHARED}
         PUBLIC_HEADER DESTINATION include
         ARCHIVE DESTINATION lib
